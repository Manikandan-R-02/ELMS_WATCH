# The one backend this app talks to — its gateway address.
VITE_API_BASE_URL=https://api.example.com/api-gateway
# Month-closing service (on hold by the backend team). Leave blank until it is migrated.
VITE_MONTH_CLOSING_URL=

# Extra origins (space separated) the page's Content-Security-Policy should allow fetch/axios to
# call, beyond the API addresses above — see build/cspPlugin.ts. Normally blank.
VITE_CSP_EXTRA_CONNECT_SRC=
